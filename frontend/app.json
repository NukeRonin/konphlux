{
  "expo": {
    "name": "Konphlux",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "konphlux.konphlux.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos to your Bazaar listings",
        "NSCameraUsageDescription": "Take a photo for your Bazaar listing",
        "NSMicrophoneUsageDescription": "Record voice-overs for your AI videos",
        "NSLocationWhenInUseUsageDescription": "Find great businesses reviewed near you",
        "NSFaceIDUsageDescription": "Unlock Treasury with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121A26"
      },
      "edgeToEdgeEnabled": true,
      "package": "konphlux.konphlux.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121A26"
        }
      ],
      "expo-web-browser",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice-overs for your AI videos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find great businesses reviewed near you"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Treasury with Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}